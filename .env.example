# ==============================================================================
# VARIABLES D'ENVIRONNEMENT — PLATEFORME E-COMMERCE LES LABORATOIRES T. WILEY
# ==============================================================================
# Ne commitez JAMAIS de fichier .env.local contenant vos vraies clés secrètes.
# Utilisez ce fichier comme modèle pour configurer vos variables sur Vercel.
# ==============================================================================

# 1. URL Publique du site (pour le SEO, sitemap et liens WhatsApp)
NEXT_PUBLIC_SITE_URL=https://votre-site.vercel.app

# 2. Identifiants de l'Administrateur unique
ADMIN_EMAIL=twileyleslaboratoires@gmail.com
ADMIN_PASSWORD=votre_mot_de_passe_securise_ici_2026

# 3. Clé secrète de signature des sessions (générer une longue chaîne aléatoire)
SESSION_SECRET=twiley_secure_super_random_session_key_production_2026

# 4. Configuration Supabase (Base de données et Stockage)
# Récupérables dans Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_votre_cle_publique_ici
SUPABASE_SERVICE_ROLE_KEY=sb_secret_votre_cle_privee_service_role_ici
